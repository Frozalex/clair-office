{
  "name": "clair-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Une suite bureautique libre, locale et accessible : documents et présentations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && vitest run",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.md docs/*.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md docs/*.md"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "docx": "9.7.1",
    "dompurify": "3.4.17",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
